# Web app configuration. Copy to `.env`. Every variable is required.

# Base URL of the API, including the version: a path behind the dev proxy
# (or nginx in Docker), or a full URL. Built into the bundle.
VITE_API_BASE_URL=/api/v1

# Dev server only (`npm run dev -w apps/web`); not part of the bundle.
WEB_PORT=5173
# Where the dev server forwards `/api` requests: the API started with `npm run start:dev -w apps/api`
API_PROXY_TARGET=http://localhost:3000
