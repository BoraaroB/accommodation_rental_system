# API configuration. Copy to `.env` (and to `.env.test` for the e2e tests).
# Every variable is required; the API does not start without it.

# development | test | production
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGIN=http://localhost:5173
# fatal | error | warn | log | debug | verbose — the least severe level written
LOG_LEVEL=log
# pretty | json
LOG_FORMAT=pretty
