# API configuration. Copy to `.env` (and to `.env.test` for the e2e tests).
# Every variable is required; the API does not start without it.

# development | test | production
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGIN=http://localhost:5173
# fatal | error | warn | log | debug | verbose — the least severe level written
LOG_LEVEL=log
# pretty | json
LOG_FORMAT=pretty
# PostgreSQL connection; matches the root .env.example (docker compose).
# In .env.test the database name must end in `_test` (booking_test).
DATABASE_URL=postgresql://booking:change-me@localhost:5432/booking
# Key that signs the access tokens: at least 32 random characters, never committed
# (e.g. `openssl rand -base64 48`). The placeholder is too short on purpose, so the
# API does not start until a real secret is set.
JWT_SECRET=change-me
# Access token lifetime in seconds
JWT_EXPIRES_IN=3600

# Seed (`npm run db:seed`) only; the API does not read these.
# Directory with listings.csv and bookings.csv, relative to apps/api
SEED_DATA_DIR=../../data
# Password of every seeded account (at least 8 characters)
SEED_DEMO_PASSWORD=change-me-demo
