# Docker Compose configuration. Copy to `.env`; every variable is required.
# The values run the stack locally; anywhere else set real secrets.

# PostgreSQL
POSTGRES_USER=booking
# Only characters that need no escaping in a URL (letters, digits, - . _ ~):
# the password is also part of the API's DATABASE_URL
POSTGRES_PASSWORD=change-me
POSTGRES_DB=booking
# Database for the API e2e tests, created on the first start
POSTGRES_TEST_DB=booking_test
# Host port (published on 127.0.0.1 only)
POSTGRES_PORT=5432

# API
# Port the API listens on, also published on 127.0.0.1
API_PORT=3000
# Comma-separated origins allowed to call the API from a browser: the web app
CORS_ORIGIN=http://localhost:8080
# Key that signs the access tokens, at least 32 characters. This value is for
# running the stack locally only; anywhere else use a random one
# (e.g. `openssl rand -base64 48`).
JWT_SECRET=local-only-secret-never-use-it-outside-local
# Access token lifetime in seconds
JWT_EXPIRES_IN=3600
# fatal | error | warn | log | debug | verbose — the least severe level written
LOG_LEVEL=log
# Password of every seeded account (at least 8 characters)
SEED_DEMO_PASSWORD=change-me-demo

# Web app
# Host port of the web app (published on 127.0.0.1 only)
WEB_PORT=8080
# Where nginx forwards /api requests: the `api` service on API_PORT, as
# scheme://host:port without a path or trailing slash
API_UPSTREAM=http://api:3000
# API base URL built into the bundle: behind nginx, on the same origin
VITE_API_BASE_URL=/api/v1
